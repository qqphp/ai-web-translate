{
  "name": "llm-web-translator",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:i18n": "node scripts/generate-i18n.mjs",
    "prebuild": "npm run generate:i18n",
    "build": "tsc --noEmit && node scripts/build-icons.mjs && vite build && node scripts/validate-build.mjs",
    "benchmark:translation": "node scripts/benchmark-translation.mjs",
    "package:release": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "pretest": "npm run generate:i18n",
    "test": "vitest run",
    "pretest:watch": "npm run generate:i18n",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.325",
    "@types/jsdom": "^21.1.7",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
